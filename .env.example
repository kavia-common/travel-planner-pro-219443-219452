# Core endpoints
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=

# Runtime and logging
REACT_APP_NODE_ENV=development
REACT_APP_LOG_LEVEL=info
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_TRUST_PROXY=false
REACT_APP_PORT=3000

# Healthcheck
REACT_APP_HEALTHCHECK_PATH=/health

# Feature flags (JSON or comma-separated)
REACT_APP_FEATURE_FLAGS={"FEATURE_BUDGET":true,"ITINERARY_CALENDAR":true,"PLACES_SEARCH":true}
REACT_APP_EXPERIMENTS_ENABLED=false

# Currency (optional)
REACT_APP_EXCHANGE_RATES_URL=
REACT_APP_EXCHANGE_RATES_API_KEY=

# Places Search (optional provider config)
# Default provider is OpenStreetMap/Nominatim (no key required)
REACT_APP_PLACES_PROVIDER=openstreetmap
REACT_APP_NOMINATIM_URL=https://nominatim.openstreetmap.org
# For Mapbox provider:
REACT_APP_MAPBOX_TOKEN=
# For Google provider (demo placeholder):
REACT_APP_GOOGLE_MAPS_API_KEY=

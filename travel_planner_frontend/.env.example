# Core endpoints
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=

# Runtime
REACT_APP_NODE_ENV=development
REACT_APP_LOG_LEVEL=info
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_TRUST_PROXY=false
REACT_APP_PORT=3000
REACT_APP_HEALTHCHECK_PATH=/health

# Feature flags
REACT_APP_FEATURE_FLAGS={"FEATURE_BUDGET":true,"ITINERARY_CALENDAR":true,"PLACES_SEARCH":true,"FEATURE_NOTIFICATIONS":true,"REMINDERS":true,"BROWSER_NOTIFICATIONS":true,"TIMELINE_MAP":true}
REACT_APP_EXPERIMENTS_ENABLED=false
REACT_APP_TIMELINE_MAP=true

# Places providers (optional)
REACT_APP_PLACES_PROVIDER=openstreetmap
REACT_APP_NOMINATIM_URL=https://nominatim.openstreetmap.org
REACT_APP_MAPBOX_TOKEN=
REACT_APP_GOOGLE_MAPS_API_KEY=

# Map provider for MapTimeline (defaults to maplibre)
REACT_APP_MAP_PROVIDER=maplibre

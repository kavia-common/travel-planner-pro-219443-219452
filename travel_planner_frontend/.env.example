# Core endpoints
REACT_APP_API_BASE=http://localhost:4000/api
REACT_APP_BACKEND_URL=http://localhost:4000
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_WS_URL=

# Runtime
REACT_APP_NODE_ENV=development
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/health

# Feature flags (JSON)
# Example enables Budget, Explore, Trip Wizard, and the new Itinerary Calendar:
# REACT_APP_FEATURE_FLAGS={"FEATURE_BUDGET":true,"FEATURE_EXPLORE":true,"TRIP_WIZARD":true,"ITINERARY_CALENDAR":true}
REACT_APP_FEATURE_FLAGS={"FEATURE_BUDGET":true,"FEATURE_EXPLORE":true,"TRIP_WIZARD":true,"ITINERARY_CALENDAR":true}

# Experiments
REACT_APP_EXPERIMENTS_ENABLED=false

# Telemetry
REACT_APP_NEXT_TELEMETRY_DISABLED=1

# Example environment for Travel Planner Frontend

REACT_APP_API_BASE=http://localhost:4000
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_WS_URL=

REACT_APP_NODE_ENV=development
REACT_APP_LOG_LEVEL=info
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_TRUST_PROXY=false
REACT_APP_PORT=3000
REACT_APP_HEALTHCHECK_PATH=/health

# Feature flags (JSON or comma-separated string supported by project)
# For JSON-based flags used by src/flags/featureFlags.js:
# REACT_APP_FEATURE_FLAGS={"TRIP_WIZARD":true,"FEATURE_BUDGET":true,"PACKING_LIST":true}
#
# For comma-separated flags used by env parsing helpers (legacy support):
# REACT_APP_FEATURE_FLAGS=FEATURE_BUDGET,PACKING_LIST
REACT_APP_FEATURE_FLAGS={"TRIP_WIZARD":true,"FEATURE_BUDGET":true,"PACKING_LIST":true}
REACT_APP_EXPERIMENTS_ENABLED=false
